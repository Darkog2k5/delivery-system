# ==============================================================================
# SPX-CLONE-2026 — Environment Variables Template
# ==============================================================================

# Shared JWT Secret (Must match across api-gateway and user-service)
JWT_SECRET=SpxDeliverySystemSecretKeyForMicroservices2026PTITNhom24MustBeLongEnough256Bits
JWT_EXPIRATION_MS=86400000

# RabbitMQ Credentials (Ports: 5672 AMQP, 15672 Management UI)
RABBITMQ_USER=spx_user
RABBITMQ_PASS=spx_pass_2026

# Domain 1 - PostgreSQL Credentials (UserDB & OrderDB)
POSTGRES_USER=spx_admin
POSTGRES_PASSWORD=spx_pg_pass_2026

# Domain 2 - MySQL Credentials (DispatchDB)
MYSQL_ROOT_PASSWORD=spx_mysql_root_2026
MYSQL_USER=spx_dispatch
MYSQL_PASSWORD=spx_mysql_pass_2026

# Domain 3 - MongoDB Credentials (TrackingDB)
MONGO_INITDB_ROOT_USERNAME=spx_mongo
MONGO_INITDB_ROOT_PASSWORD=spx_mongo_pass_2026

# Web Portal Gateway URL (Browser calls API Gateway on Port 8080)
VITE_API_GATEWAY_URL=http://localhost:8080

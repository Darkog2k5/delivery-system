#!/bin/sh
# Minimal POSIX Gradle Wrapper launcher script for Android Studio / CI
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v gradle >/dev/null 2>&1; then
  exec gradle -p "$APP_HOME" "$@"
else
  echo "Gradle not found in PATH. Please open clients/android-app in Android Studio (Gradle 8.9)." >&2
  exit 1
fi
